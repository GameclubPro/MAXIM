{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@maxim/contracts": ["packages/contracts/src/index.ts"],
      "@maxim/contracts/bot-speech": ["packages/contracts/src/bot-speech.ts"],
      "@maxim/contracts/broadcast": ["packages/contracts/src/broadcast.ts"],
      "@maxim/contracts/channel-dialog": ["packages/contracts/src/channel-dialog.ts"],
      "@maxim/contracts/channel-post-signature": [
        "packages/contracts/src/channel-post-signature.ts"
      ],
      "@maxim/contracts/channel-stats": ["packages/contracts/src/channel-stats.ts"],
      "@maxim/contracts/chat-participants": ["packages/contracts/src/chat-participants.ts"],
      "@maxim/contracts/giveaway": ["packages/contracts/src/giveaway.ts"],
      "@maxim/contracts/karavan-storefront": ["packages/contracts/src/karavan-storefront.ts"],
      "@maxim/contracts/managed-entities": ["packages/contracts/src/managed-entities.ts"],
      "@maxim/contracts/manual-moderation": ["packages/contracts/src/manual-moderation.ts"],
      "@maxim/contracts/poll": ["packages/contracts/src/poll.ts"],
      "@maxim/contracts/publication": ["packages/contracts/src/publication.ts"],
      "@maxim/contracts/publisher": ["packages/contracts/src/publisher.ts"],
      "@maxim/contracts/safety-desk": ["packages/contracts/src/safety-desk.ts"],
      "@maxim/contracts/settings": ["packages/contracts/src/settings.ts"],
      "@maxim/contracts/support-requests": ["packages/contracts/src/support-requests.ts"],
      "@maxim/contracts/system": ["packages/contracts/src/system.ts"],
      "@maxim/contracts/vk-parsing": ["packages/contracts/src/vk-parsing.ts"]
    }
  }
}
