{
  "name": "@maxim/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "default": "./dist/settings.js"
    },
    "./bot-speech": {
      "types": "./dist/bot-speech.d.ts",
      "default": "./dist/bot-speech.js"
    },
    "./broadcast": {
      "types": "./dist/broadcast.d.ts",
      "default": "./dist/broadcast.js"
    },
    "./channel-stats": {
      "types": "./dist/channel-stats.d.ts",
      "default": "./dist/channel-stats.js"
    },
    "./channel-dialog": {
      "types": "./dist/channel-dialog.d.ts",
      "default": "./dist/channel-dialog.js"
    },
    "./channel-post-signature": {
      "types": "./dist/channel-post-signature.d.ts",
      "default": "./dist/channel-post-signature.js"
    },
    "./chat-participants": {
      "types": "./dist/chat-participants.d.ts",
      "default": "./dist/chat-participants.js"
    },
    "./manual-moderation": {
      "types": "./dist/manual-moderation.d.ts",
      "default": "./dist/manual-moderation.js"
    },
    "./managed-entities": {
      "types": "./dist/managed-entities.d.ts",
      "default": "./dist/managed-entities.js"
    },
    "./giveaway": {
      "types": "./dist/giveaway.d.ts",
      "default": "./dist/giveaway.js"
    },
    "./poll": {
      "types": "./dist/poll.d.ts",
      "default": "./dist/poll.js"
    },
    "./publication": {
      "types": "./dist/publication.d.ts",
      "default": "./dist/publication.js"
    },
    "./safety-desk": {
      "types": "./dist/safety-desk.d.ts",
      "default": "./dist/safety-desk.js"
    },
    "./support-requests": {
      "types": "./dist/support-requests.d.ts",
      "default": "./dist/support-requests.js"
    },
    "./system": {
      "types": "./dist/system.d.ts",
      "default": "./dist/system.js"
    },
    "./vk-parsing": {
      "types": "./dist/vk-parsing.d.ts",
      "default": "./dist/vk-parsing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/with-file-lock.mjs contracts-build -- npm run build:source",
    "build:source": "node ../../scripts/clean-dist.mjs dist && tsc -p tsconfig.json && node ../../scripts/check-contract-exports.mjs --build-output",
    "test": "npm run build && npm run test:source",
    "test:source": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
