{
  "name": "@maxim/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "default": "./dist/settings.js"
    },
    "./bot-speech": {
      "types": "./dist/bot-speech.d.ts",
      "default": "./dist/bot-speech.js"
    },
    "./broadcast": {
      "types": "./dist/broadcast.d.ts",
      "default": "./dist/broadcast.js"
    },
    "./channel-dialog": {
      "types": "./dist/channel-dialog.d.ts",
      "default": "./dist/channel-dialog.js"
    },
    "./managed-entities": {
      "types": "./dist/managed-entities.d.ts",
      "default": "./dist/managed-entities.js"
    },
    "./giveaway": {
      "types": "./dist/giveaway.d.ts",
      "default": "./dist/giveaway.js"
    },
    "./system": {
      "types": "./dist/system.d.ts",
      "default": "./dist/system.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.2"
  }
}
