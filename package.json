{
  "name": "maxim",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @maxim/contracts && npm run build --workspace @maxim/api && npm run build --workspace @maxim/miniapp && npm run build --workspace @maxim/admin",
    "build:miniapp:production": "VITE_API_BASE=https://major-maksimov.ru/api/v1 npm run build --workspace @maxim/miniapp",
    "build:docker": "docker build -f apps/api/Dockerfile -t maxim-api-ci . && docker build -f apps/miniapp/Dockerfile -t maxim-miniapp-ci . && docker build -f apps/admin/Dockerfile -t maxim-admin-ci .",
    "check": "npm run check:static && npm run check:docs && npm run check:infra && npm run check:contracts && npm run check:api && npm run check:prisma && npm run check:miniapp && npm run build:miniapp:production && npm run check:admin",
    "check:admin": "npm run test:admin && npm run build --workspace @maxim/admin && npm run smoke:admin",
    "check:api": "npm run check:ci --workspace @maxim/api",
    "check:miniapp": "npm run check:miniapp-css && npm run typecheck:miniapp && npm run test:miniapp",
    "check:miniapp-css": "npm run check:css --workspace @maxim/miniapp",
    "check:prisma": "npm run prisma:check --workspace @maxim/api",
    "check:refactor-guards": "node scripts/check-refactor-guards.mjs",
    "check:static": "npm run lint && npm run check:refactor-guards && npm run test:agent-tools",
    "check:contracts": "npm run typecheck:contracts && npm run test:contracts",
    "check:docs": "node scripts/check-docs.mjs",
    "check:infra": "bash infra/scripts/check-infra.sh",
    "agent:plan": "node scripts/agent/plan.mjs",
    "agent:verify": "node scripts/agent/verify.mjs",
    "ci:assert-green": "node scripts/ci/assert-green.mjs",
    "dev": "npm run dev:api",
    "dev:all": "concurrently --kill-others-on-fail -n api,miniapp,admin -c blue,magenta,cyan \"npm run dev --workspace @maxim/api\" \"npm run dev --workspace @maxim/miniapp\" \"npm run dev --workspace @maxim/admin\"",
    "dev:admin": "npm run dev --workspace @maxim/admin",
    "dev:api": "npm run dev --workspace @maxim/api",
    "dev:miniapp": "npm run dev --workspace @maxim/miniapp",
    "emulator:miniapp": "node scripts/open-miniapp-emulator.mjs",
    "emulator:miniapp:android": "node scripts/open-miniapp-emulator.mjs --device android",
    "emulator:miniapp:iphone": "node scripts/open-miniapp-emulator.mjs --device iphone",
    "audit:miniapp:visual": "node scripts/audit-miniapp-visual.mjs",
    "lint": "eslint .",
    "loadtest:webhook": "npm exec --workspace @maxim/api -- tsx src/scripts/loadtest-webhook-ingress.ts",
    "screenshots:miniapp": "node scripts/capture-miniapp-preview.mjs",
    "screenshots:miniapp:smoke": "npm run visual:smoke --workspace @maxim/miniapp",
    "smoke:admin": "node scripts/smoke-admin.mjs",
    "typecheck": "npm run typecheck --workspace @maxim/contracts && npm run typecheck --workspace @maxim/api && npm run typecheck --workspace @maxim/miniapp && npm run typecheck --workspace @maxim/admin",
    "typecheck:admin": "npm run typecheck --workspace @maxim/admin",
    "typecheck:api": "npm run typecheck --workspace @maxim/api",
    "typecheck:contracts": "npm run typecheck --workspace @maxim/contracts",
    "typecheck:miniapp": "npm run typecheck --workspace @maxim/miniapp",
    "test": "npm run test:contracts && npm run test:api && npm run test:miniapp && npm run test:admin",
    "test:admin": "npm run test --workspace @maxim/admin",
    "test:api": "npm run test --workspace @maxim/api",
    "test:api:ci": "npm run test:ci --workspace @maxim/api",
    "test:api:commercial-benchmark:ci": "npm run test:commercial-benchmark:ci --workspace @maxim/api",
    "test:contracts": "npm run test --workspace @maxim/contracts",
    "test:miniapp": "npm run test --workspace @maxim/miniapp",
    "test:agent-tools": "node --test scripts/*.test.mjs scripts/agent/test/*.test.mjs scripts/ci/*.test.mjs infra/scripts/*.test.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "prepare": "husky",
    "vps": "bash infra/scripts/vps-connect.sh",
    "prod": "bash infra/scripts/vps-connect.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@nestjs/platform-fastify": "11.1.24",
    "@prisma/config": "7.9.0",
    "@prisma/dev": "0.24.14",
    "@types/node": "^24.12.4",
    "concurrently": "^9.2.1",
    "eslint": "^10.9.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md,yml,yaml}": "prettier --write"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "axios": "1.18.1",
    "brace-expansion@>=1.0.0 <2.0.0": "1.1.18",
    "brace-expansion@>=2.0.0 <3.0.0": "2.1.4",
    "brace-expansion@>=5.0.0 <6.0.0": "5.0.9",
    "deepmerge-ts": "8.0.1",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.5",
    "fastify": "5.8.5",
    "find-my-way": "9.7.0",
    "form-data": "4.0.6",
    "hono": "4.12.28",
    "js-yaml@>=3.0.0 <4.0.0": "3.15.1",
    "js-yaml@>=4.0.0 <5.0.0": "4.3.1",
    "qs": "6.15.3",
    "shell-quote": "1.9.0",
    "valibot": "1.4.2"
  }
}
