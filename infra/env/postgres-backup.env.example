# Install as /etc/maxim-postgres-backup.env with mode 0600.
# Backup and disposable restore roots use cold storage. It shares the production RAID failure domain.
MAXIM_BACKUP_DIR=/mnt/maxim-cold/backups/maxim
MAXIM_BACKUP_RETENTION_DAYS=2
MAXIM_BACKUP_MIN_FREE_BYTES=17179869184
MAXIM_BACKUP_REQUIRE_DEDICATED_FILESYSTEM=1
MAXIM_BACKUP_RATE_LIMIT_BYTES_PER_SEC=1048576
MAXIM_BACKUP_MAX_DURATION_SEC=43200
MAXIM_BACKUP_READINESS_URL=http://127.0.0.1:3001/api/health/ready
MAXIM_BACKUP_READINESS_TIMEOUT_SEC=10
MAXIM_BACKUP_WATCHDOG_INTERVAL_SEC=30
MAXIM_BACKUP_WATCHDOG_FAILURE_THRESHOLD=2
MAXIM_RESTORE_SMOKE_DATA_ROOT=/mnt/maxim-cold/restore-smoke/maxim
MAXIM_RESTORE_SMOKE_MIN_FREE_BYTES=17179869184
MAXIM_RESTORE_SMOKE_REQUIRED_PERCENT=125
MAXIM_RESTORE_SMOKE_REQUIRE_DEDICATED_FILESYSTEM=1

# REG.RU nested capacity guard; reserve both budgets independently, never add free space.
MAXIM_BACKUP_BACKING_FILESYSTEM_PATH=/var/lib/migration-storage
# Enable only after dedicated credentials, public recipients and readback have been tested.
MAXIM_BACKUP_REPLICATION_REQUIRED=0
MAXIM_BACKUP_AGE_RECIPIENTS=/etc/maxim-backup/recipients.txt
MAXIM_BACKUP_RCLONE_CONFIG=/etc/maxim-backup/rclone.conf
MAXIM_BACKUP_REMOTE_PREFIX=maxim-reg-s3:maxim-backups-reg-20261011/postgres
MAXIM_BACKUP_REPLICATION_TIMEOUT_SEC=21600
MAXIM_BACKUP_REPLICATION_BYTES_PER_SEC=16777216
MAXIM_RESTORE_SMOKE_MAX_DURATION_SEC=43200
