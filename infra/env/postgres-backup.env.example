# Install as /etc/maxim-postgres-backup.env with mode 0600.
# Backup and restore roots must be separate mounted volumes, not directories on production /.
MAXIM_BACKUP_DIR=/mnt/maxim-backups
MAXIM_BACKUP_RETENTION_DAYS=14
MAXIM_BACKUP_MIN_FREE_BYTES=2147483648
MAXIM_BACKUP_REQUIRE_DEDICATED_FILESYSTEM=1
MAXIM_RESTORE_SMOKE_DATA_ROOT=/mnt/maxim-restore-smoke
MAXIM_RESTORE_SMOKE_MIN_FREE_BYTES=2147483648
MAXIM_RESTORE_SMOKE_REQUIRED_PERCENT=125
MAXIM_RESTORE_SMOKE_REQUIRE_DEDICATED_FILESYSTEM=1
