# Copy this file to the repository root as `.env.vps` on each local device.
# Keep `.env.vps` out of git. It may contain local usernames, key paths, and
# Yandex Cloud profile names, but never production app secrets.

# Existing SSH alias or direct target, for example:
#   maxim-vps
#   ubuntu@203.0.113.10
MAXIM_VPS_SSH_TARGET=maxim-vps

# Repository path on the VPS.
MAXIM_VPS_REPO_DIR=/var/www/Chat_bot

# Public production origin used by health checks.
MAXIM_VPS_PUBLIC_URL=https://major-maksimov.ru

# Optional SSH settings. Prefer $HOME over ~ so shell sourcing expands it.
# MAXIM_VPS_SSH_PORT=22
# MAXIM_VPS_SSH_KEY=$HOME/.ssh/maxim-vps
# MAXIM_VPS_SSH_CONFIG=$HOME/.ssh/config
# MAXIM_VPS_SSH_EXTRA_ARGS="-o StrictHostKeyChecking=accept-new"

# Optional Yandex Cloud fallback for manual shell recovery:
# https://yandex.cloud/en/docs/compute/cli-ref/ssh/
# MAXIM_YC_VM_NAME=
# MAXIM_YC_VM_ID=
# MAXIM_YC_LOGIN=
# MAXIM_YC_PROFILE=
# MAXIM_YC_IDENTITY_FILE=$HOME/.ssh/maxim-vps

# Optional Yandex Cloud security-group helper. `allow-ssh-current-ip` adds the
# current public IPv4/32 to the SSH rule list, and `ensure-ssh` runs that before
# `doctor`. Keep this as a narrow /32 rule, not 0.0.0.0/0.
# MAXIM_YC_SSH_SECURITY_GROUP_ID=
# MAXIM_YC_SSH_SECURITY_GROUP_NAME=
# MAXIM_YC_SSH_SOURCE_CIDR=
# MAXIM_PUBLIC_IP_URL=https://api.ipify.org
# MAXIM_VPS_AUTO_AUTHORIZE_SSH=0
# MAXIM_YC_COMMAND_TIMEOUT_SEC=30

# Optional operator-side encrypted backup pull settings. These are read only by
# infra/scripts/pull-latest-backup-to-local.sh and pull-backup-to-local.sh on the
# PC; they are never sent to the VPS. Keep the age identity private (mode 0600).
# MAXIM_BACKUP_AGE_RECIPIENT_FILE=$HOME/.config/maxim-backup/recipients.txt
# MAXIM_BACKUP_AGE_IDENTITY_FILE=$HOME/.config/maxim-backup/age-key.txt
# MAXIM_BACKUP_PULL_KIND=postgres
# MAXIM_BACKUP_PULL_REMOTE_DIR=/mnt/maxim-cold/backups/maxim
# MAXIM_BACKUP_PULL_LOCAL_DIR=$HOME/backups/maxim-vps/postgres/encrypted
# For a separate Karavan Task Scheduler action, override these two values:
# MAXIM_BACKUP_PULL_KIND=karavan
# MAXIM_BACKUP_PULL_REMOTE_DIR=/mnt/maxim-cold/backups/karavan
# MAXIM_BACKUP_PULL_LOCAL_DIR=$HOME/backups/maxim-vps/karavan/encrypted
# Keep 14 days by default: a 23 GiB daily PostgreSQL dump would otherwise consume
# roughly 690 GiB in a month on the operator disk. Increase only after checking
# local free space and the backup growth rate.
# MAXIM_BACKUP_LOCAL_RETENTION_DAYS=14
# MAXIM_BACKUP_LOCAL_KEEP_COUNT=2
# MAXIM_BACKUP_PULL_REPAIR_PARTIAL=0
# MAXIM_BACKUP_PULL_MAX_BYTES=107374182400
# MAXIM_BACKUP_PULL_MIN_FREE_BYTES=1073741824

# Direct live PostgreSQL stream for a PC-scheduled backup after the cold disk
# migration is proven. The helper refuses degraded API readiness by default,
# encrypts before publication, and throttles the remote dump to 10 MiB/s.
# MAXIM_LIVE_POSTGRES_LOCAL_DIR=$HOME/backups/maxim-vps/postgres/encrypted
# MAXIM_LIVE_POSTGRES_RATE_LIMIT_BYTES_PER_SEC=10485760
# MAXIM_LIVE_POSTGRES_REQUIRE_READY=1
# MAXIM_LIVE_POSTGRES_MAX_DURATION_SEC=21600
# MAXIM_LIVE_POSTGRES_RETENTION_DAYS=14
# MAXIM_LIVE_POSTGRES_KEEP_COUNT=2
