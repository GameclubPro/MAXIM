  engagementPublishedMessageId String?                    @map("engagement_published_message_id")
  engagementPublishedThreadId  String?                    @map("engagement_published_thread_id")
  engagementPublishedAt        DateTime?                  @map("engagement_published_at")
  createdAt                    DateTime                   @default(now()) @map("created_at")
  updatedAt                    DateTime                   @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("channel_settings")
}

model ManagedPoll {
  id                 String            @id @default(cuid())
  chatId             String            @unique @map("chat_id")
  question           String            @default("")
  options            Json              @default("[]")
  status             ManagedPollStatus @default(DRAFT)
  activeVersion      Int               @default(0) @map("active_version")
  publishedMessageId String?           @map("published_message_id")
  publishedUrl       String?           @map("published_url")
  publishedAt        DateTime?         @map("published_at")
  closedAt           DateTime?         @map("closed_at")
