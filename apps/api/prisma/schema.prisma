generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProfanityLevel {
  LOW
  MEDIUM
  HIGH
}

enum LinkPolicy {
  ALLOWLIST_ONLY
  BLOCKLIST_ONLY
  ALERT_ONLY
}

enum CommercialAdsSensitivity {
  BALANCED
  STRICT
}

enum EventType {
  MESSAGE
  MEMBER_ACTION
  SYSTEM
}

enum SanctionAction {
  NONE
  WARN
  DELETE_MESSAGE
  KICK
  BAN
}

enum Operator {
  BOT
  ADMIN
}

enum WebhookStatus {
  RECEIVED
  QUEUED
  PROCESSED
  DUPLICATE
  FAILED
}

enum ChatEntityType {
  CHAT
  CHANNEL
}

enum ChannelAutoPostButtonsMode {
  OFF
  COMMENTS
  SUGGEST
  BOTH
}

model Chat {
  id         String         @id
  title      String
  entityType ChatEntityType @default(CHAT) @map("entity_type")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  settings            ChatSettings?
  channelSettings     ChannelSettings?
  admins              ChatAdminAllowlist[]
  domains             DomainAllowlist[]
  violations          Violation[]
  events              ModerationEvent[]
  auditLogs           AuditLog[]

  @@map("chats")
}

model ChatSettings {
  id                     String         @id @default(cuid())
  chatId                 String         @unique @map("chat_id")
  duplicateWarnEnabled   Boolean        @default(true) @map("duplicate_warn_enabled")
  duplicateKickEnabled   Boolean        @default(true) @map("duplicate_kick_enabled")
  duplicateBanEnabled    Boolean        @default(true) @map("duplicate_ban_enabled")
  antiDuplicateEnabled   Boolean        @default(true) @map("anti_duplicate_enabled")
  duplicateWarnWindowSec Int            @default(43200) @map("duplicate_warn_window_sec")
  duplicateWarnMaxCount  Int            @default(2) @map("duplicate_warn_max_count")
  duplicateKickWindowSec Int            @default(86400) @map("duplicate_kick_window_sec")
  duplicateKickMaxCount  Int            @default(3) @map("duplicate_kick_max_count")
  duplicateBanWindowSec  Int            @default(172800) @map("duplicate_ban_window_sec")
  duplicateBanMaxCount   Int            @default(4) @map("duplicate_ban_max_count")
  linkPolicy             LinkPolicy     @default(ALLOWLIST_ONLY) @map("link_policy")
  greetingEnabled        Boolean        @default(false) @map("greeting_enabled")
  greetingBotMessageEnabled Boolean     @default(true) @map("greeting_bot_message_enabled")
  greetingBotMessageText String         @default("") @map("greeting_bot_message_text")
  greetingBotButtonEnabled Boolean      @default(false) @map("greeting_bot_button_enabled")
  greetingBotButtonUrl   String         @default("") @map("greeting_bot_button_url")
  greetingBotButtonText  String         @default("Открыть") @map("greeting_bot_button_text")
  deleteBotMessagesEnabled Boolean      @default(true) @map("delete_bot_messages_enabled")
  deleteBotMessagesDelayMinutes Int     @default(2) @map("delete_bot_messages_delay_minutes")
  removeBotsFromGroupEnabled Boolean    @default(false) @map("remove_bots_from_group_enabled")
  globalUserBlacklistEnabled Boolean    @default(false) @map("global_user_blacklist_enabled")
  globalCrossChatSpamEnabled Boolean    @default(false) @map("global_cross_chat_spam_enabled")
  antiSpamEnabled         Boolean        @default(true) @map("anti_spam_enabled")
  maxMessageLengthEnabled Boolean       @default(false) @map("max_message_length_enabled")
  maxMessageLength       Int            @default(1500) @map("max_message_length")
  photoMessageCooldownEnabled Boolean   @default(false) @map("photo_message_cooldown_enabled")
  photoMessageCooldownHours Int         @default(1) @map("photo_message_cooldown_hours")
  stickerMessageCooldownEnabled Boolean @default(false) @map("sticker_message_cooldown_enabled")
  stickerMessageCooldownMinutes Int     @default(5) @map("sticker_message_cooldown_minutes")
  videoMessagesEnabled   Boolean        @default(true) @map("video_messages_enabled")
  fileMessagesEnabled    Boolean        @default(true) @map("file_messages_enabled")
  voiceMessagesEnabled   Boolean        @default(true) @map("voice_messages_enabled")
  messageLimitsBotMessageEnabled Boolean @default(false) @map("message_limits_bot_message_enabled")
  messageLimitsBotMessageText String    @default("") @map("message_limits_bot_message_text")
  messageLimitsWarnEnabled Boolean      @default(false) @map("message_limits_warn_enabled")
  messageLimitsBanEnabled Boolean       @default(false) @map("message_limits_ban_enabled")
  messageLimitsKickEnabled Boolean      @default(false) @map("message_limits_kick_enabled")
  messageLimitsBotButtonEnabled Boolean @default(false) @map("message_limits_bot_button_enabled")
  messageLimitsBotButtonUrl String      @default("") @map("message_limits_bot_button_url")
  messageLimitsBotButtonText String     @default("Открыть") @map("message_limits_bot_button_text")
  russianProfanityFilterEnabled Boolean @default(true) @map("russian_profanity_filter_enabled")
  commercialAdsFilterEnabled Boolean    @default(false) @map("commercial_ads_filter_enabled")
  commercialAdsSensitivity CommercialAdsSensitivity @default(BALANCED) @map("commercial_ads_sensitivity")
  commercialAdsWarnThreshold Int        @default(45) @map("commercial_ads_warn_threshold")
  commercialAdsDeleteThreshold Int      @default(65) @map("commercial_ads_delete_threshold")
  profanityBotMessageEnabled Boolean    @default(false) @map("profanity_bot_message_enabled")
  profanityWarnEnabled      Boolean     @default(false) @map("profanity_warn_enabled")
  profanityBanEnabled       Boolean     @default(false) @map("profanity_ban_enabled")
  profanityKickEnabled      Boolean     @default(false) @map("profanity_kick_enabled")
  textFiltersBotMessageEnabled Boolean  @default(false) @map("text_filters_bot_message_enabled")
  textFiltersBotMessageText String      @default("") @map("text_filters_bot_message_text")
  textFiltersWarnEnabled Boolean        @default(false) @map("text_filters_warn_enabled")
  textFiltersWarnMessageText String     @default("") @map("text_filters_warn_message_text")
  textFiltersBanEnabled Boolean         @default(false) @map("text_filters_ban_enabled")
  textFiltersKickEnabled Boolean        @default(false) @map("text_filters_kick_enabled")
  textFiltersBotButtonEnabled Boolean   @default(false) @map("text_filters_bot_button_enabled")
  textFiltersBotButtonUrl String        @default("") @map("text_filters_bot_button_url")
  textFiltersBotButtonText String       @default("Открыть") @map("text_filters_bot_button_text")
  nightModeEnabled       Boolean        @default(false) @map("night_mode_enabled")
  nightModeStartTimeMinutes Int         @default(1380) @map("night_mode_start_time_minutes")
  nightModeEndTimeMinutes Int           @default(480) @map("night_mode_end_time_minutes")
  nightModeTimezone      String         @default("Europe/Moscow") @map("night_mode_timezone")
  nightModeBotMessageEnabled Boolean    @default(true) @map("night_mode_bot_message_enabled")
  nightModeBotMessageText String        @default("") @map("night_mode_bot_message_text")
  nightModeBotButtonEnabled Boolean     @default(false) @map("night_mode_bot_button_enabled")
  nightModeBotButtonUrl  String         @default("") @map("night_mode_bot_button_url")
  nightModeBotButtonText String         @default("Открыть") @map("night_mode_bot_button_text")
  linkBotMessageEnabled  Boolean        @default(true) @map("link_bot_message_enabled")
  linkBotMessageText     String         @default("") @map("link_bot_message_text")
  linkWarnEnabled        Boolean        @default(false) @map("link_warn_enabled")
  linkWarnMessageText    String         @default("") @map("link_warn_message_text")
  linkBanEnabled         Boolean        @default(false) @map("link_ban_enabled")
  linkKickEnabled        Boolean        @default(false) @map("link_kick_enabled")
  linkBotButtonEnabled   Boolean        @default(false) @map("link_bot_button_enabled")
  linkBotButtonUrl       String         @default("") @map("link_bot_button_url")
  linkBotButtonText      String         @default("Открыть") @map("link_bot_button_text")
  duplicateBotMessageEnabled Boolean    @default(false) @map("duplicate_bot_message_enabled")
  duplicateBotMessageText String        @default("") @map("duplicate_bot_message_text")
  duplicateBotButtonEnabled Boolean     @default(false) @map("duplicate_bot_button_enabled")
  duplicateBotButtonUrl  String         @default("") @map("duplicate_bot_button_url")
  duplicateBotButtonText String         @default("Открыть") @map("duplicate_bot_button_text")
  banDurationHours       Int            @default(6) @map("ban_duration_hours")
  warnThreshold          Int            @default(3) @map("warn_threshold")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("chat_settings")
}

model ChannelSettings {
  autoPostButtonsMode         ChannelAutoPostButtonsMode @default(OFF) @map("auto_post_buttons_mode")
  id                          String   @id @default(cuid())
  chatId                      String   @unique @map("chat_id")
  postSuggestionsEnabled      Boolean  @default(false) @map("post_suggestions_enabled")
  postSuggestionsText         String   @default("") @map("post_suggestions_text")
  postSuggestionsButtonEnabled Boolean @default(false) @map("post_suggestions_button_enabled")
  postSuggestionsButtonText   String   @default("Предложить пост") @map("post_suggestions_button_text")
  postSuggestionsButtonUrl    String   @default("") @map("post_suggestions_button_url")
  commentsEnabled             Boolean  @default(true) @map("comments_enabled")
  commentsModerationEnabled   Boolean  @default(false) @map("comments_moderation_enabled")
  commentsSlowModeSeconds     Int      @default(0) @map("comments_slow_mode_seconds")
  commentsMessageText         String   @default("") @map("comments_message_text")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("channel_settings")
}

model ChatAdminAllowlist {
  chatId    String   @map("chat_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@map("chat_admin_allowlist")
}

model DomainAllowlist {
  chatId    String   @map("chat_id")
  domain    String
  createdAt DateTime @default(now()) @map("created_at")
  removeAfterAt DateTime? @map("remove_after_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([chatId, domain])
  @@index([chatId, removeAfterAt], map: "domain_allowlist_chat_id_remove_after_at_idx")
  @@map("domain_allowlist")
}

model GlobalUserBlacklist {
  userId      String   @id @map("user_id")
  sourceChatId String? @map("source_chat_id")
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("global_user_blacklist")
}

model BadwordDictionary {
  id          String   @id @default(cuid())
  language    String
  word        String
  severity    Int      @default(2)
  isException Boolean  @default(false) @map("is_exception")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([language, word])
  @@map("badword_dictionary")
}

model Violation {
  id        String   @id @default(cuid())
  chatId    String   @map("chat_id")
  userId    String   @map("user_id")
  ruleCode  String   @map("rule_code")
  score     Float    @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, userId, createdAt])
  @@index([chatId, userId, ruleCode, createdAt])
  @@map("violations")
}

model ModerationEvent {
  id            String         @id @default(cuid())
  chatId         String         @map("chat_id")
  userId         String         @map("user_id")
  messageId      String?        @map("message_id")
  eventType      EventType      @map("event_type")
  ruleCode       String         @map("rule_code")
  action         SanctionAction
  maskedExcerpt  String?        @map("masked_excerpt")
  score          Float          @default(1)
  operator       Operator       @default(BOT)
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@index([chatId, userId, createdAt])
  @@index([chatId, userId, action, createdAt(sort: Desc)])
  @@map("moderation_events")
}

model WebhookEvent {
  id                String        @id @default(cuid())
  dedupKey          String        @unique @map("dedup_key")
  status            WebhookStatus @default(RECEIVED)
  sourceIp          String?       @map("source_ip")
  rawPayload        Json          @map("raw_payload")
  normalizedPayload Json          @map("normalized_payload")
  errorMessage      String?       @map("error_message")
  queuedAt          DateTime?     @map("queued_at")
  enqueueAttempts   Int           @default(0) @map("enqueue_attempts")
  nextEnqueueAt     DateTime?     @map("next_enqueue_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  processedAt       DateTime?     @map("processed_at")

  @@index([status, createdAt])
  @@index([status, nextEnqueueAt, createdAt])
  @@map("webhook_events")
}

model AuditLog {
  id          String   @id @default(cuid())
  chatId       String   @map("chat_id")
  actorUserId  String   @map("actor_user_id")
  action       String
  payload      Json
  createdAt    DateTime @default(now()) @map("created_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("audit_logs")
}
