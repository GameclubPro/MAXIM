model ChatInvitationAccessProgress {
  id             String    @id @default(cuid())
  chatId         String    @map("chat_id")
  userId         String    @map("user_id")
  invitedUserIds String[]  @default([]) @map("invited_user_ids")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId], map: "chat_invitation_access_progress_chat_id_user_id_key")
  @@index([chatId, completedAt], map: "chat_invitation_access_progress_chat_id_completed_at_idx")
  @@map("chat_invitation_access_progress")
}

model ChatRules {
  id                 String    @id @default(cuid())
  chatId             String    @unique @map("chat_id")
  text               String    @default("")
  imageBase64        String    @default("") @map("image_base64")
  imageMimeType      String    @default("") @map("image_mime_type")
  imageFileName      String    @default("") @map("image_file_name")
  autoTextEnabled    Boolean   @default(false) @map("auto_text_enabled")
  buttons            Json      @default("[]")
  buttonEnabled      Boolean   @default(false) @map("button_enabled")
  buttonUrl          String    @default("") @map("button_url")
  buttonText         String    @default("Открыть") @map("button_text")
  publishedMessageId String?   @map("published_message_id")
  publishedUrl       String?   @map("published_url")
  publishedAt        DateTime? @map("published_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("chat_rules")
}

