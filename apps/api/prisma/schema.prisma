generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProfanityLevel {
  LOW
  MEDIUM
  HIGH
}

enum LinkPolicy {
  ALLOWLIST_ONLY
  BLOCKLIST_ONLY
  ALERT_ONLY
}

enum CommercialAdsSensitivity {
  BALANCED
  STRICT
}

enum BotSpeechStyle {
  ROBOT
  FRIENDLY
  POLICE
  IRONIC
}

enum EventType {
  MESSAGE
  MEMBER_ACTION
  SYSTEM
}

enum SanctionAction {
  NONE
  WARN
  DELETE_MESSAGE
  KICK
  BAN
}

enum Operator {
  BOT
  ADMIN
}

enum WebhookStatus {
  RECEIVED
  QUEUED
  PROCESSED
  DUPLICATE
  FAILED
}

enum ChatEntityType {
  CHAT
  CHANNEL
}

enum ChannelAutoPostButtonsMode {
  OFF
  COMMENTS
  SUGGEST
  BOTH
}

enum ManagedPollStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ManagedGiveawayStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  DRAWING
  COMPLETED
  CANCELED
}

enum GiveawayEligibilityState {
  PENDING
  VERIFIED
  REJECTED
}

enum ManagedGiveawayWinnerStatus {
  SELECTED
  CLAIMED
  DELIVERED
  EXPIRED
  REROLLED
}

enum ManagedBroadcastStatus {
  ACTIVE
  PARTIAL
  FAILED
  COMPLETED
  CANCELED
}

enum ManagedBroadcastDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELED
}

model Chat {
  id         String         @id
  title      String
  entityType ChatEntityType @default(CHAT) @map("entity_type")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  settings                 ChatSettings?
  rules                    ChatRules?
  poll                     ManagedPoll?
  channelSettings          ChannelSettings?
  admins                   ChatAdminAllowlist[]
  domains                  DomainAllowlist[]
  violations               Violation[]
  events                   ModerationEvent[]
  auditLogs                AuditLog[]
  channelAudienceSnapshots ChannelAudienceSnapshot[]
  channelPosts             ChannelPost[]
  channelStatsSyncState    ChannelStatsSyncState?
  managedBroadcasts        ManagedBroadcast[]
  managedGiveaways         ManagedGiveaway[]

  @@map("chats")
}

model ChatSettings {
  id                               String                   @id @default(cuid())
  chatId                           String                   @unique @map("chat_id")
  duplicateWarnEnabled             Boolean                  @default(true) @map("duplicate_warn_enabled")
  duplicateKickEnabled             Boolean                  @default(true) @map("duplicate_kick_enabled")
  duplicateBanEnabled              Boolean                  @default(true) @map("duplicate_ban_enabled")
  antiDuplicateEnabled             Boolean                  @default(true) @map("anti_duplicate_enabled")
  duplicateWarnWindowSec           Int                      @default(43200) @map("duplicate_warn_window_sec")
  duplicateWarnMaxCount            Int                      @default(2) @map("duplicate_warn_max_count")
  duplicateKickWindowSec           Int                      @default(86400) @map("duplicate_kick_window_sec")
  duplicateKickMaxCount            Int                      @default(3) @map("duplicate_kick_max_count")
  duplicateBanWindowSec            Int                      @default(172800) @map("duplicate_ban_window_sec")
  duplicateBanMaxCount             Int                      @default(4) @map("duplicate_ban_max_count")
  linkPolicy                       LinkPolicy               @default(ALLOWLIST_ONLY) @map("link_policy")
  botSpeechStyle                   BotSpeechStyle?          @default(FRIENDLY) @map("bot_speech_style")
  greetingEnabled                  Boolean                  @default(false) @map("greeting_enabled")
  greetingBotMessageEnabled        Boolean                  @default(true) @map("greeting_bot_message_enabled")
  greetingBotMessageText           String                   @default("") @map("greeting_bot_message_text")
  greetingBotButtonEnabled         Boolean                  @default(false) @map("greeting_bot_button_enabled")
  greetingBotButtonUrl             String                   @default("") @map("greeting_bot_button_url")
  greetingBotButtonText            String                   @default("Открыть") @map("greeting_bot_button_text")
  greetingRulesButtonEnabled       Boolean                  @default(false) @map("greeting_rules_button_enabled")
  deleteBotMessagesEnabled         Boolean                  @default(true) @map("delete_bot_messages_enabled")
  deleteBotMessagesDelayMinutes    Int                      @default(2) @map("delete_bot_messages_delay_minutes")
  removeBotsFromGroupEnabled       Boolean                  @default(true) @map("remove_bots_from_group_enabled")
  deleteSpammersEnabled            Boolean                  @default(false) @map("delete_spammers_enabled")
  antiSpamEnabled                  Boolean                  @default(true) @map("anti_spam_enabled")
  messageCountLimitEnabled         Boolean                  @default(false) @map("message_count_limit_enabled")
  messageCountLimitMessages        Int                      @default(5) @map("message_count_limit_messages")
  messageCountLimitWindowHours     Int                      @default(1) @map("message_count_limit_window_hours")
  maxMessageLengthEnabled          Boolean                  @default(false) @map("max_message_length_enabled")
  maxMessageLength                 Int                      @default(1500) @map("max_message_length")
  photoMessageCooldownEnabled      Boolean                  @default(false) @map("photo_message_cooldown_enabled")
  photoMessageCooldownHours        Int                      @default(1) @map("photo_message_cooldown_hours")
  stickerMessageCooldownEnabled    Boolean                  @default(false) @map("sticker_message_cooldown_enabled")
  stickerMessageCooldownMinutes    Int                      @default(5) @map("sticker_message_cooldown_minutes")
  videoMessagesEnabled             Boolean                  @default(true) @map("video_messages_enabled")
  fileMessagesEnabled              Boolean                  @default(true) @map("file_messages_enabled")
  voiceMessagesEnabled             Boolean                  @default(true) @map("voice_messages_enabled")
  messageLimitsBotMessageEnabled   Boolean                  @default(false) @map("message_limits_bot_message_enabled")
  messageLimitsBotMessageText      String                   @default("") @map("message_limits_bot_message_text")
  messageLimitsWarnEnabled         Boolean                  @default(false) @map("message_limits_warn_enabled")
  messageLimitsBanEnabled          Boolean                  @default(false) @map("message_limits_ban_enabled")
  messageLimitsKickEnabled         Boolean                  @default(false) @map("message_limits_kick_enabled")
  messageLimitsBotButtonEnabled    Boolean                  @default(false) @map("message_limits_bot_button_enabled")
  messageLimitsBotButtonUrl        String                   @default("") @map("message_limits_bot_button_url")
  messageLimitsBotButtonText       String                   @default("Открыть") @map("message_limits_bot_button_text")
  russianProfanityFilterEnabled    Boolean                  @default(true) @map("russian_profanity_filter_enabled")
  commercialAdsFilterEnabled       Boolean                  @default(false) @map("commercial_ads_filter_enabled")
  commercialAdsSensitivity         CommercialAdsSensitivity @default(BALANCED) @map("commercial_ads_sensitivity")
  commercialAdsWarnThreshold       Int                      @default(45) @map("commercial_ads_warn_threshold")
  commercialAdsDeleteThreshold     Int                      @default(65) @map("commercial_ads_delete_threshold")
  profanityBotMessageEnabled       Boolean                  @default(false) @map("profanity_bot_message_enabled")
  profanityWarnEnabled             Boolean                  @default(false) @map("profanity_warn_enabled")
  profanityBanEnabled              Boolean                  @default(false) @map("profanity_ban_enabled")
  profanityKickEnabled             Boolean                  @default(false) @map("profanity_kick_enabled")
  textFiltersBotMessageEnabled     Boolean                  @default(false) @map("text_filters_bot_message_enabled")
  textFiltersBotMessageText        String                   @default("") @map("text_filters_bot_message_text")
  textFiltersWarnEnabled           Boolean                  @default(false) @map("text_filters_warn_enabled")
  textFiltersWarnMessageText       String                   @default("") @map("text_filters_warn_message_text")
  textFiltersBanEnabled            Boolean                  @default(false) @map("text_filters_ban_enabled")
  textFiltersKickEnabled           Boolean                  @default(false) @map("text_filters_kick_enabled")
  textFiltersBotButtonEnabled      Boolean                  @default(false) @map("text_filters_bot_button_enabled")
  textFiltersBotButtonUrl          String                   @default("") @map("text_filters_bot_button_url")
  textFiltersBotButtonText         String                   @default("Открыть") @map("text_filters_bot_button_text")
  textFiltersRulesButtonEnabled    Boolean                  @default(false) @map("text_filters_rules_button_enabled")
  thematicCodewordEnabled          Boolean                  @default(false) @map("thematic_codeword_enabled")
  thematicCodeword                 String                   @default("") @map("thematic_codeword")
  thematicFiltersBotMessageEnabled Boolean                  @default(false) @map("thematic_filters_bot_message_enabled")
  thematicFiltersWarnEnabled       Boolean                  @default(false) @map("thematic_filters_warn_enabled")
  thematicFiltersBanEnabled        Boolean                  @default(false) @map("thematic_filters_ban_enabled")
  thematicFiltersKickEnabled       Boolean                  @default(false) @map("thematic_filters_kick_enabled")
  thematicFiltersBotButtonEnabled  Boolean                  @default(false) @map("thematic_filters_bot_button_enabled")
  thematicFiltersBotButtonUrl      String                   @default("") @map("thematic_filters_bot_button_url")
  thematicFiltersBotButtonText     String                   @default("Открыть") @map("thematic_filters_bot_button_text")
  thematicFiltersRulesButtonEnabled Boolean                 @default(false) @map("thematic_filters_rules_button_enabled")
  nightModeEnabled                 Boolean                  @default(false) @map("night_mode_enabled")
  nightModeStartTimeMinutes        Int                      @default(1380) @map("night_mode_start_time_minutes")
  nightModeEndTimeMinutes          Int                      @default(480) @map("night_mode_end_time_minutes")
  nightModeTimezone                String                   @default("Europe/Moscow") @map("night_mode_timezone")
  nightModeBotMessageEnabled       Boolean                  @default(false) @map("night_mode_bot_message_enabled")
  nightModeBotMessageText          String                   @default("") @map("night_mode_bot_message_text")
  nightModeOpenMessageEnabled      Boolean                  @default(true) @map("night_mode_open_message_enabled")
  nightModeOpenMessageText         String                   @default("") @map("night_mode_open_message_text")
  nightModeBotButtonEnabled        Boolean                  @default(false) @map("night_mode_bot_button_enabled")
  nightModeBotButtonUrl            String                   @default("") @map("night_mode_bot_button_url")
  nightModeBotButtonText           String                   @default("Открыть") @map("night_mode_bot_button_text")
  nightModeRulesButtonEnabled      Boolean                  @default(false) @map("night_mode_rules_button_enabled")
  linkBotMessageEnabled            Boolean                  @default(true) @map("link_bot_message_enabled")
  linkBotMessageText               String                   @default("") @map("link_bot_message_text")
  linkWarnEnabled                  Boolean                  @default(false) @map("link_warn_enabled")
  linkWarnMessageText              String                   @default("") @map("link_warn_message_text")
  linkBanEnabled                   Boolean                  @default(false) @map("link_ban_enabled")
  linkKickEnabled                  Boolean                  @default(false) @map("link_kick_enabled")
  linkBotButtonEnabled             Boolean                  @default(false) @map("link_bot_button_enabled")
  linkBotButtonUrl                 String                   @default("") @map("link_bot_button_url")
  linkBotButtonText                String                   @default("Открыть") @map("link_bot_button_text")
  linkRulesButtonEnabled           Boolean                  @default(false) @map("link_rules_button_enabled")
  duplicateBotMessageEnabled       Boolean                  @default(false) @map("duplicate_bot_message_enabled")
  duplicateBotMessageText          String                   @default("") @map("duplicate_bot_message_text")
  duplicateBotButtonEnabled        Boolean                  @default(false) @map("duplicate_bot_button_enabled")
  duplicateBotButtonUrl            String                   @default("") @map("duplicate_bot_button_url")
  duplicateBotButtonText           String                   @default("Открыть") @map("duplicate_bot_button_text")
  duplicateRulesButtonEnabled      Boolean                  @default(false) @map("duplicate_rules_button_enabled")
  messageLimitsRulesButtonEnabled  Boolean                  @default(false) @map("message_limits_rules_button_enabled")
  rulesAttachViolationsEnabled     Boolean                  @default(true) @map("rules_attach_violations_enabled")
  banDurationHours                 Int                      @default(6) @map("ban_duration_hours")
  warnThreshold                    Int                      @default(3) @map("warn_threshold")
  createdAt                        DateTime                 @default(now()) @map("created_at")
  updatedAt                        DateTime                 @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("chat_settings")
}

model ChatRules {
  id                 String    @id @default(cuid())
  chatId             String    @unique @map("chat_id")
  text               String    @default("")
  imageBase64        String    @default("") @map("image_base64")
  imageMimeType      String    @default("") @map("image_mime_type")
  imageFileName      String    @default("") @map("image_file_name")
  autoTextEnabled    Boolean   @default(false) @map("auto_text_enabled")
  publishedMessageId String? @map("published_message_id")
  publishedUrl       String?   @map("published_url")
  publishedAt        DateTime? @map("published_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("chat_rules")
}

model ChannelSettings {
  autoPostButtonsMode          ChannelAutoPostButtonsMode @default(OFF) @map("auto_post_buttons_mode")
  id                           String                     @id @default(cuid())
  chatId                       String                     @unique @map("chat_id")
  postSuggestionsEnabled       Boolean                    @default(false) @map("post_suggestions_enabled")
  postSuggestionsText          String                     @default("") @map("post_suggestions_text")
  engagementMessageText        String                     @default("Есть идея или обратная связь? Нажмите кнопку ниже.") @map("engagement_message_text")
  postSuggestionsButtonEnabled Boolean                    @default(false) @map("post_suggestions_button_enabled")
  postSuggestionsButtonText    String                     @default("Предложить пост") @map("post_suggestions_button_text")
  postSuggestionsButtonUrl     String                     @default("") @map("post_suggestions_button_url")
  commentsEnabled              Boolean                    @default(true) @map("comments_enabled")
  commentsModerationEnabled    Boolean                    @default(false) @map("comments_moderation_enabled")
  commentsBlockLinksEnabled    Boolean                    @default(true) @map("comments_block_links_enabled")
  commentsAntiSpamEnabled      Boolean                    @default(true) @map("comments_anti_spam_enabled")
  commentsLimitTwoInRowEnabled Boolean                    @default(true) @map("comments_limit_two_in_row_enabled")
  commentsMessageText          String                     @default("") @map("comments_message_text")
  engagementPublishedMessageId String?                    @map("engagement_published_message_id")
  engagementPublishedThreadId  String?                    @map("engagement_published_thread_id")
  engagementPublishedAt        DateTime?                  @map("engagement_published_at")
  createdAt                    DateTime                   @default(now()) @map("created_at")
  updatedAt                    DateTime                   @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("channel_settings")
}

model ManagedPoll {
  id                 String            @id @default(cuid())
  chatId             String            @unique @map("chat_id")
  question           String            @default("")
  options            Json              @default("[]")
  status             ManagedPollStatus @default(DRAFT)
  activeVersion      Int               @default(0) @map("active_version")
  publishedMessageId String?           @map("published_message_id")
  publishedUrl       String?           @map("published_url")
  publishedAt        DateTime?         @map("published_at")
  closedAt           DateTime?         @map("closed_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  chat  Chat                @relation(fields: [chatId], references: [id], onDelete: Cascade)
  votes ManagedPollVote[]

  @@map("managed_polls")
}

model ManagedPollVote {
  id         String   @id @default(cuid())
  pollId     String   @map("poll_id")
  pollVersion Int     @map("poll_version")
  userId     String   @map("user_id")
  optionIndex Int     @map("option_index")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  poll ManagedPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, pollVersion, userId])
  @@index([pollId, pollVersion, optionIndex])
  @@map("managed_poll_votes")
}

model ChatAdminAllowlist {
  chatId    String   @map("chat_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@map("chat_admin_allowlist")
}

model DomainAllowlist {
  chatId        String    @map("chat_id")
  domain        String
  createdAt     DateTime  @default(now()) @map("created_at")
  removeAfterAt DateTime? @map("remove_after_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([chatId, domain])
  @@index([chatId, removeAfterAt], map: "domain_allowlist_chat_id_remove_after_at_idx")
  @@map("domain_allowlist")
}

model GlobalSpammer {
  userId         String   @id @map("user_id")
  firstDetectedAt DateTime @default(now()) @map("first_detected_at")
  lastDetectedAt DateTime @updatedAt @map("last_detected_at")
  detectionsCount Int      @default(1) @map("detections_count")
  lastReason     String    @map("last_reason")
  lastChatId     String?   @map("last_chat_id")
  lastEvidence   Json?     @map("last_evidence")

  @@map("global_spammers")
}

model BadwordDictionary {
  id          String   @id @default(cuid())
  language    String
  word        String
  severity    Int      @default(2)
  isException Boolean  @default(false) @map("is_exception")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([language, word])
  @@map("badword_dictionary")
}

model Violation {
  id        String   @id @default(cuid())
  chatId    String   @map("chat_id")
  userId    String   @map("user_id")
  ruleCode  String   @map("rule_code")
  score     Float    @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, userId, createdAt])
  @@index([chatId, userId, ruleCode, createdAt])
  @@map("violations")
}

model ModerationEvent {
  id            String         @id @default(cuid())
  chatId        String         @map("chat_id")
  userId        String         @map("user_id")
  messageId     String?        @map("message_id")
  eventType     EventType      @map("event_type")
  ruleCode      String         @map("rule_code")
  action        SanctionAction
  maskedExcerpt String?        @map("masked_excerpt")
  score         Float          @default(1)
  operator      Operator       @default(BOT)
  metadata      Json?
  createdAt     DateTime       @default(now()) @map("created_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@index([chatId, userId, createdAt])
  @@index([chatId, userId, action, createdAt(sort: Desc)])
  @@map("moderation_events")
}

model WebhookEvent {
  id                String        @id @default(cuid())
  dedupKey          String        @unique @map("dedup_key")
  status            WebhookStatus @default(RECEIVED)
  sourceIp          String?       @map("source_ip")
  rawPayload        Json          @map("raw_payload")
  normalizedPayload Json          @map("normalized_payload")
  errorMessage      String?       @map("error_message")
  queuedAt          DateTime?     @map("queued_at")
  enqueueAttempts   Int           @default(0) @map("enqueue_attempts")
  nextEnqueueAt     DateTime?     @map("next_enqueue_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  processedAt       DateTime?     @map("processed_at")

  @@index([status, createdAt])
  @@index([status, nextEnqueueAt, createdAt])
  @@map("webhook_events")
}

model AuditLog {
  id          String   @id @default(cuid())
  chatId      String   @map("chat_id")
  actorUserId String   @map("actor_user_id")
  action      String
  payload     Json
  createdAt   DateTime @default(now()) @map("created_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("audit_logs")
}

model ManagedBroadcast {
  id             String                 @id @default(cuid())
  sourceChatId   String                 @map("source_chat_id")
  entityType     ChatEntityType         @default(CHAT) @map("entity_type")
  actorUserId    String                 @map("actor_user_id")
  text           String                 @default("")
  textFormat     String                 @default("plain") @map("text_format")
  applyToAllChats Boolean               @default(false) @map("apply_to_all_chats")
  targetChatIds  Json                   @map("target_chat_ids")
  buttonEnabled  Boolean                @default(false) @map("button_enabled")
  buttonUrl      String                 @default("") @map("button_url")
  buttonText     String                 @default("Открыть") @map("button_text")
  imageEnabled   Boolean                @default(false) @map("image_enabled")
  imageBase64    String                 @default("") @map("image_base64")
  imageMimeType  String                 @default("") @map("image_mime_type")
  imageFileName  String                 @default("") @map("image_file_name")
  nextSendAt     DateTime?              @map("next_send_at")
  cycleEnabled   Boolean                @default(false) @map("cycle_enabled")
  cycleEveryHours Int                   @default(1) @map("cycle_every_hours")
  cycleCount     Int                    @default(1) @map("cycle_count")
  sentCount      Int                    @default(0) @map("sent_count")
  status         ManagedBroadcastStatus @default(ACTIVE)
  lastError      String?                @map("last_error")
  lockedAt       DateTime?              @map("locked_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  chat       Chat                       @relation(fields: [sourceChatId], references: [id], onDelete: Cascade)
  deliveries ManagedBroadcastDelivery[]

  @@index([sourceChatId, status, nextSendAt], map: "managed_broadcasts_source_chat_id_status_next_send_at_idx")
  @@index([status, nextSendAt], map: "managed_broadcasts_status_next_send_at_idx")
  @@map("managed_broadcasts")
}

model ManagedBroadcastDelivery {
  id              String                        @id @default(cuid())
  broadcastId     String                        @map("broadcast_id")
  occurrenceIndex Int                           @map("occurrence_index")
  targetChatId    String                        @map("target_chat_id")
  status          ManagedBroadcastDeliveryStatus @default(PENDING)
  attemptCount    Int                           @default(0) @map("attempt_count")
  lastError       String?                       @map("last_error")
  sentAt          DateTime?                     @map("sent_at")
  lockedAt        DateTime?                     @map("locked_at")
  createdAt       DateTime                      @default(now()) @map("created_at")
  updatedAt       DateTime                      @updatedAt @map("updated_at")

  broadcast ManagedBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, occurrenceIndex, targetChatId], map: "managed_broadcast_deliveries_broadcast_occurrence_target_key")
  @@index([broadcastId, occurrenceIndex, status], map: "managed_broadcast_deliveries_broadcast_occurrence_status_idx")
  @@index([status, lockedAt], map: "managed_broadcast_deliveries_status_locked_at_idx")
  @@map("managed_broadcast_deliveries")
}

model ManagedGiveaway {
  id                   String                @id @default(cuid())
  sourceChatId         String                @map("source_chat_id")
  entityType           ChatEntityType        @default(CHAT) @map("entity_type")
  actorUserId          String                @map("actor_user_id")
  title                String
  description          String                @default("")
  imageEnabled         Boolean               @default(false) @map("image_enabled")
  imageBase64          String                @default("") @map("image_base64")
  imageMimeType        String                @default("") @map("image_mime_type")
  imageFileName        String                @default("") @map("image_file_name")
  startsAt             DateTime?             @map("starts_at")
  endsAt               DateTime              @map("ends_at")
  claimHours           Int                   @default(24) @map("claim_hours")
  requiredChannelIds   Json                  @default("[]") @map("required_channel_ids")
  status               ManagedGiveawayStatus @default(DRAFT)
  publicationMessageId String?               @map("publication_message_id")
  publicationUrl       String?               @map("publication_url")
  publishedAt          DateTime?             @map("published_at")
  resultsMessageId     String?               @map("results_message_id")
  resultsUrl           String?               @map("results_url")
  drawSeed             String?               @map("draw_seed")
  drawnAt              DateTime?             @map("drawn_at")
  completedAt          DateTime?             @map("completed_at")
  canceledAt           DateTime?             @map("canceled_at")
  lockedAt             DateTime?             @map("locked_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  chat    Chat                     @relation(fields: [sourceChatId], references: [id], onDelete: Cascade)
  prizes  ManagedGiveawayPrize[]
  entries ManagedGiveawayEntry[]
  winners ManagedGiveawayWinner[]

  @@index([sourceChatId, status, createdAt], map: "managed_giveaways_source_chat_id_status_created_at_idx")
  @@index([status, startsAt], map: "managed_giveaways_status_starts_at_idx")
  @@index([status, endsAt], map: "managed_giveaways_status_ends_at_idx")
  @@index([status, lockedAt], map: "managed_giveaways_status_locked_at_idx")
  @@map("managed_giveaways")
}

model ManagedGiveawayPrize {
  id         String   @id @default(cuid())
  giveawayId String   @map("giveaway_id")
  position   Int
  title      String
  createdAt  DateTime @default(now()) @map("created_at")

  giveaway ManagedGiveaway       @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  winners  ManagedGiveawayWinner[]

  @@unique([giveawayId, position])
  @@map("managed_giveaway_prizes")
}

model ManagedGiveawayEntry {
  id                String                   @id @default(cuid())
  giveawayId        String                   @map("giveaway_id")
  userId            String                   @map("user_id")
  displayName       String?                  @map("display_name")
  joinedAt          DateTime                 @default(now()) @map("joined_at")
  eligibilityState  GiveawayEligibilityState @default(PENDING) @map("eligibility_state")
  eligibilityReason String?                  @map("eligibility_reason")
  checkedAt         DateTime?                @map("checked_at")
  drawRank          String?                  @map("draw_rank")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  giveaway ManagedGiveaway        @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  winners  ManagedGiveawayWinner[]

  @@unique([giveawayId, userId])
  @@index([giveawayId, eligibilityState], map: "managed_giveaway_entries_giveaway_id_eligibility_state_idx")
  @@index([giveawayId, drawRank], map: "managed_giveaway_entries_giveaway_id_draw_rank_idx")
  @@map("managed_giveaway_entries")
}

model ManagedGiveawayWinner {
  id              String                      @id @default(cuid())
  giveawayId      String                      @map("giveaway_id")
  prizeId         String                      @map("prize_id")
  entryId         String                      @map("entry_id")
  rank            Int                         @default(0)
  status          ManagedGiveawayWinnerStatus @default(SELECTED)
  selectedAt      DateTime                    @default(now()) @map("selected_at")
  claimDeadlineAt DateTime?                   @map("claim_deadline_at")
  claimedAt       DateTime?                   @map("claimed_at")
  deliveredAt     DateTime?                   @map("delivered_at")
  expiredAt       DateTime?                   @map("expired_at")
  rerolledAt      DateTime?                   @map("rerolled_at")
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")

  giveaway ManagedGiveaway      @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  prize    ManagedGiveawayPrize @relation(fields: [prizeId], references: [id], onDelete: Cascade)
  entry    ManagedGiveawayEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([giveawayId, status], map: "managed_giveaway_winners_giveaway_id_status_idx")
  @@index([giveawayId, prizeId], map: "managed_giveaway_winners_giveaway_id_prize_id_idx")
  @@index([entryId], map: "managed_giveaway_winners_entry_id_idx")
  @@map("managed_giveaway_winners")
}

model ChannelAudienceSnapshot {
  id                String    @id @default(cuid())
  chatId            String    @map("chat_id")
  participantsCount Int?      @map("participants_count")
  status            String?
  isPublic          Boolean?  @map("is_public")
  link              String?
  lastEventAt       DateTime? @map("last_event_at")
  capturedAt        DateTime  @default(now()) @map("captured_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, capturedAt(sort: Desc)])
  @@map("channel_audience_snapshots")
}

model ChannelPost {
  id                   String    @id @default(cuid())
  chatId               String    @map("chat_id")
  messageId            String    @map("message_id")
  publishedAt          DateTime  @map("published_at")
  url                  String?
  latestViews          Int       @default(0) @map("latest_views")
  latestReactions      Json?     @map("latest_reactions")
  latestReactionsTotal Int       @default(0) @map("latest_reactions_total")
  latestSnapshotAt     DateTime? @map("latest_snapshot_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  chat          Chat                      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  viewSnapshots ChannelPostViewSnapshot[]

  @@unique([chatId, messageId])
  @@index([chatId, publishedAt(sort: Desc)])
  @@index([chatId, latestSnapshotAt(sort: Desc)])
  @@map("channel_posts")
}

model ChannelPostViewSnapshot {
  id            String   @id @default(cuid())
  channelPostId String   @map("channel_post_id")
  views         Int
  capturedAt    DateTime @default(now()) @map("captured_at")

  channelPost ChannelPost @relation(fields: [channelPostId], references: [id], onDelete: Cascade)

  @@index([channelPostId, capturedAt(sort: Desc)])
  @@index([capturedAt])
  @@map("channel_post_view_snapshots")
}

model ChannelStatsSyncState {
  id                      String    @id @default(cuid())
  chatId                  String    @unique @map("chat_id")
  viewsCoverageFrom       DateTime? @map("views_coverage_from")
  membershipCoverageFrom  DateTime? @map("membership_coverage_from")
  lastAudienceSyncAt      DateTime? @map("last_audience_sync_at")
  lastViewsSyncAt         DateTime? @map("last_views_sync_at")
  lastOpportunisticSyncAt DateTime? @map("last_opportunistic_sync_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("channel_stats_sync_states")
}
