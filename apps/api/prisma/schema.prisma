model Chat {
  id             String           @id
  botId          String?          @map("bot_id")
  primaryBotId   String?          @map("primary_bot_id")
  title          String
  entityType     ChatEntityType   @default(CHAT) @map("entity_type")
  catalogKind    ChatCatalogKind  @default(UNKNOWN) @map("catalog_kind")
  routingState   ChatRoutingState @default(NO_ELIGIBLE_BOT) @map("routing_state")
  routingVersion Int              @default(0) @map("routing_version")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  settings                        ChatSettings?
  rules                           ChatRules?
  channelSettings                 ChannelSettings?
  admins                          ChatAdminAllowlist[]
  domains                         DomainAllowlist[]
  violations                      Violation[]
  events                          ModerationEvent[]
  violationMessageClaims          ModerationViolationMessageClaim[]
  moderationDeleteIntents         ModerationDeleteIntent[]
  auditLogs                       AuditLog[]
  channelAutoPostAttachMarkers    ChannelAutoPostAttachMarker[]
  chatAutoCommentAttachMarkers    ChatAutoCommentAttachMarker[]
  channelAudienceSnapshots        ChannelAudienceSnapshot[]
  channelPosts                    ChannelPost[]
  channelStatsSyncState           ChannelStatsSyncState?
  managedBroadcasts               ManagedBroadcast[]
  managedAutopostRules            ManagedAutopostRule[]
  publicationTargets              PublicationTarget[]
  managedGiveaways                ManagedGiveaway[]
  managedPolls                    ManagedPoll[]
  vkParsingSettings               VkParsingSettings?
  vkParsingSources                VkParsingSource[]
  vkParsingPosts                  VkParsingPost[]
  botMemberships                  ChatBotMembership[]
  accessEdges                     ManagedEntityAccessEdge[]
  adminMembers                    ManagedEntityAdminMember[]
  favorites                       ManagedEntityFavorite[]
  dialogNotificationSubscriptions DialogNotificationSubscription[]
  dialogNotificationPreferences   DialogNotificationPreference[]
  participantImmunities           ChatParticipantModerationImmunity[]
  invitationAccessProgress        ChatInvitationAccessProgress[]
  spammerObservations             SpammerObservation[]
  globalSpammerCandidateChats     GlobalSpammerCandidateChat[]

  @@index([botId], map: "chats_bot_id_idx")
  @@index([primaryBotId], map: "chats_primary_bot_id_idx")
  @@index([routingState, entityType], map: "chats_routing_state_entity_type_idx")
  @@index([catalogKind, entityType], map: "chats_catalog_kind_entity_type_idx")
  @@index([entityType, updatedAt(sort: Desc), id], map: "chats_entity_type_updated_id_idx")
  @@map("chats")
}

model ChatBotMembership {
  id                        String                  @id @default(cuid())
  chatId                    String                  @map("chat_id")
  botId                     String                  @map("bot_id")
  role                      ChatBotMembershipRole   @default(STANDBY)
  status                    ChatBotMembershipStatus @default(ACTIVE)
  capabilities              Json                    @default("[]")
  permissionsSnapshot       Json?                   @map("permissions_snapshot")
  botAccessState            ChatBotAccessState      @default(UNKNOWN) @map("bot_access_state")
  botAccessCheckedAt        DateTime?               @map("bot_access_checked_at")
  botAccessExpiresAt        DateTime?               @map("bot_access_expires_at")
  botAccessSource           String?                 @map("bot_access_source")
  botAccessLastErrorCode    String?                 @map("bot_access_last_error_code")
  permissionsHash           String?                 @map("permissions_hash")
  sendRouteFailureCount     Int                     @default(0) @map("send_route_failure_count")
  sendRouteQuarantinedUntil DateTime?               @map("send_route_quarantined_until")
  sendRouteLastFailureAt    DateTime?               @map("send_route_last_failure_at")
  sendRouteLastFailureCode  String?                 @map("send_route_last_failure_code")
  sendRouteLastSuccessAt    DateTime?               @map("send_route_last_success_at")
  lastSeenAt                DateTime?               @map("last_seen_at")
  lastWebhookAt             DateTime?               @map("last_webhook_at")
  lifecycleEventAt          DateTime?               @map("lifecycle_event_at")
  lifecycleEventType        String?                 @map("lifecycle_event_type")
  lifecycleSource           String?                 @map("lifecycle_source")
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, botId], map: "chat_bot_memberships_chat_id_bot_id_key")
  @@index([botId, role, status], map: "chat_bot_memberships_bot_id_role_status_idx")
  @@index([chatId, status], map: "chat_bot_memberships_chat_id_status_idx")
  @@index([chatId, botAccessState, botAccessCheckedAt(sort: Desc)], map: "chat_bot_memberships_chat_access_state_checked_idx")
  @@index([botId, botAccessState, botAccessCheckedAt(sort: Desc)], map: "chat_bot_memberships_bot_access_state_checked_idx")
  @@index([chatId, status, lifecycleEventAt(sort: Desc)], map: "chat_bot_memberships_chat_status_lifecycle_idx")
  @@map("chat_bot_memberships")
}

model ChatRoutingReconcileRequest {
  chatId         String    @id @map("chat_id")
  generation     BigInt    @default(1)
  requestedAt    DateTime  @default(now()) @map("requested_at")
  leaseToken     String?   @map("lease_token")
  leaseExpiresAt DateTime? @map("lease_expires_at")

  @@index([requestedAt, leaseExpiresAt, chatId], map: "chat_routing_reconcile_requests_due_lease_chat_idx")
  @@map("chat_routing_reconcile_requests")
}

model ChatParticipantModerationImmunity {
  id                  String    @id @default(cuid())
  chatId              String    @map("chat_id")
  userId              String    @map("user_id")
  expiresAt           DateTime? @map("expires_at")
  dailyViolationLimit Int?      @map("daily_violation_limit")
  dailyViolationUsage Int       @default(0) @map("daily_violation_usage")
  usageDateKey        String?   @map("usage_date_key")
  createdByUserId     String?   @map("created_by_user_id")
  updatedByUserId     String?   @map("updated_by_user_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId], map: "chat_participant_moderation_immunities_chat_id_user_id_key")
  @@index([chatId, expiresAt], map: "chat_participant_moderation_immunities_chat_id_expires_at_idx")
  @@map("chat_participant_moderation_immunities")
}

