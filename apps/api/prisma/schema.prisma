  id                 String    @id @default(cuid())
  url                String    @unique
  mediaIdentity      String?   @unique(map: "vk_parsing_media_cache_media_identity_key") @map("media_identity")
  status             String    @default("UNKNOWN")
  mimeType           String?   @map("mime_type")
  contentLength      Int?      @map("content_length")
  maxUploadPayload   Json?     @map("max_upload_payload")
  maxUploadToken     String?   @map("max_upload_token")
  maxUploadedAt      DateTime? @map("max_uploaded_at")
  uploadAttemptCount Int       @default(0) @map("upload_attempt_count")
  lastCheckedAt      DateTime? @map("last_checked_at")
  lastError          String?   @map("last_error")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([status, lastCheckedAt], map: "vk_parsing_media_cache_status_checked_idx")
  @@map("vk_parsing_media_cache")
}

model ManagedGiveaway {
  id                   String                @id @default(cuid())
  sourceChatId         String                @map("source_chat_id")
  entityType           ChatEntityType        @default(CHAT) @map("entity_type")
  actorUserId          String                @map("actor_user_id")
  title                String
  description          String                @default("")
  imageEnabled         Boolean               @default(false) @map("image_enabled")
  imageBase64          String                @default("") @map("image_base64")
  imageMimeType        String                @default("") @map("image_mime_type")
  imageFileName        String                @default("") @map("image_file_name")
  startsAt             DateTime?             @map("starts_at")
  endsAt               DateTime              @map("ends_at")
  claimHours           Int                   @default(24) @map("claim_hours")
  requiredChannelIds   Json                  @default("[]") @map("required_channel_ids")
  status               ManagedGiveawayStatus @default(DRAFT)
  publicationMessageId String?               @map("publication_message_id")
  publicationUrl       String?               @map("publication_url")
  publishedAt          DateTime?             @map("published_at")
  resultsMessageId     String?               @map("results_message_id")
  resultsUrl           String?               @map("results_url")
  drawSeed             String?               @map("draw_seed")
  drawnAt              DateTime?             @map("drawn_at")
  completedAt          DateTime?             @map("completed_at")
  canceledAt           DateTime?             @map("canceled_at")
  lockedAt             DateTime?             @map("locked_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  chat    Chat                    @relation(fields: [sourceChatId], references: [id], onDelete: Cascade)
  prizes  ManagedGiveawayPrize[]
  entries ManagedGiveawayEntry[]
  winners ManagedGiveawayWinner[]

  @@index([sourceChatId, status, createdAt], map: "managed_giveaways_source_chat_id_status_created_at_idx")
  @@index([status, startsAt], map: "managed_giveaways_status_starts_at_idx")
  @@index([status, endsAt], map: "managed_giveaways_status_ends_at_idx")
  @@index([status, lockedAt], map: "managed_giveaways_status_locked_at_idx")
  @@map("managed_giveaways")
}

model ManagedGiveawayPrize {
  id           String   @id @default(cuid())
  giveawayId   String   @map("giveaway_id")
  position     Int
  title        String
  displayTitle String @default("") @map("display_title")
  createdAt    DateTime @default(now()) @map("created_at")

  giveaway ManagedGiveaway         @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  winners  ManagedGiveawayWinner[]

  @@unique([giveawayId, position])
  @@map("managed_giveaway_prizes")
}

model ManagedGiveawayEntry {
  id                String                   @id @default(cuid())
  giveawayId        String                   @map("giveaway_id")
  userId            String                   @map("user_id")
  displayName       String?                  @map("display_name")
  joinedAt          DateTime                 @default(now()) @map("joined_at")
  eligibilityState  GiveawayEligibilityState @default(PENDING) @map("eligibility_state")
  eligibilityReason String?                  @map("eligibility_reason")
  missingChannelIds Json                     @default("[]") @map("missing_channel_ids")
  checkedAt         DateTime?                @map("checked_at")
  drawRank          String?                  @map("draw_rank")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  giveaway ManagedGiveaway         @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  winners  ManagedGiveawayWinner[]

  @@unique([giveawayId, userId])
  @@index([giveawayId, eligibilityState], map: "managed_giveaway_entries_giveaway_id_eligibility_state_idx")
  @@index([giveawayId, drawRank], map: "managed_giveaway_entries_giveaway_id_draw_rank_idx")
  @@map("managed_giveaway_entries")
}

model ManagedGiveawayWinner {
  id              String                      @id @default(cuid())
  giveawayId      String                      @map("giveaway_id")
  prizeId         String                      @map("prize_id")
  entryId         String                      @map("entry_id")
  rank            Int                         @default(0)
  status          ManagedGiveawayWinnerStatus @default(SELECTED)
  selectedAt      DateTime                    @default(now()) @map("selected_at")
  claimDeadlineAt DateTime?                   @map("claim_deadline_at")
  claimedAt       DateTime?                   @map("claimed_at")
  deliveredAt     DateTime?                   @map("delivered_at")
  expiredAt       DateTime?                   @map("expired_at")
  rerolledAt      DateTime?                   @map("rerolled_at")
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")

  giveaway ManagedGiveaway      @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  prize    ManagedGiveawayPrize @relation(fields: [prizeId], references: [id], onDelete: Cascade)
  entry    ManagedGiveawayEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([giveawayId, status], map: "managed_giveaway_winners_giveaway_id_status_idx")
  @@index([giveawayId, prizeId], map: "managed_giveaway_winners_giveaway_id_prize_id_idx")
  @@index([status, claimDeadlineAt], map: "managed_giveaway_winners_status_claim_deadline_at_idx")
  @@index([entryId], map: "managed_giveaway_winners_entry_id_idx")
  @@map("managed_giveaway_winners")
}

model ChannelAudienceSnapshot {
  id                String    @id @default(cuid())
  chatId            String    @map("chat_id")
  participantsCount Int?      @map("participants_count")
  status            String?
  isPublic          Boolean?  @map("is_public")
  link              String?
  lastEventAt       DateTime? @map("last_event_at")
  capturedAt        DateTime  @default(now()) @map("captured_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, capturedAt(sort: Desc)])
  @@map("channel_audience_snapshots")
}

model ChannelPost {
  id                   String    @id @default(cuid())
  chatId               String    @map("chat_id")
  messageId            String    @map("message_id")
  publishedAt          DateTime  @map("published_at")
  url                  String?
  previewUrl           String?   @map("preview_url")
  latestViews          Int       @default(0) @map("latest_views")
  latestReactions      Json?     @map("latest_reactions")
  latestReactionsTotal Int       @default(0) @map("latest_reactions_total")
  latestSnapshotAt     DateTime? @map("latest_snapshot_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  chat          Chat                      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  viewSnapshots ChannelPostViewSnapshot[]

  @@unique([chatId, messageId])
  @@index([chatId, publishedAt(sort: Desc)])
  @@index([chatId, latestSnapshotAt(sort: Desc)])
  @@map("channel_posts")
}

model ChannelPostViewSnapshot {
  id            String   @id @default(cuid())
  channelPostId String   @map("channel_post_id")
  views         Int
  reactionsTotal Int     @default(0) @map("reactions_total")
  capturedAt    DateTime @default(now()) @map("captured_at")

  channelPost ChannelPost @relation(fields: [channelPostId], references: [id], onDelete: Cascade)

  @@index([channelPostId, capturedAt(sort: Desc)])
  @@index([capturedAt])
  @@map("channel_post_view_snapshots")
}

model ChannelStatsSyncState {
  id                      String    @id @default(cuid())
  chatId                  String    @unique @map("chat_id")
  viewsCoverageFrom       DateTime? @map("views_coverage_from")
  membershipCoverageFrom  DateTime? @map("membership_coverage_from")
  lastAudienceSyncAt      DateTime? @map("last_audience_sync_at")
  lastViewsSyncAt         DateTime? @map("last_views_sync_at")
  lastOpportunisticSyncAt DateTime? @map("last_opportunistic_sync_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("channel_stats_sync_states")
}
