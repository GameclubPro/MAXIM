generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProfanityLevel {
  LOW
  MEDIUM
  HIGH
}

enum LinkPolicy {
  ALLOWLIST_ONLY
  BLOCKLIST_ONLY
  ALERT_ONLY
}

enum CommercialAdsSensitivity {
  BALANCED
  STRICT
}

enum BotSpeechStyle {
  ROBOT
  FRIENDLY
  POLICE
  IRONIC
}

enum EventType {
  MESSAGE
  MEMBER_ACTION
  SYSTEM
}

enum SanctionAction {
  NONE
  WARN
  DELETE_MESSAGE
  MUTE
  KICK
  BAN
}

enum Operator {
  BOT
  ADMIN
}

enum WebhookStatus {
  RECEIVED
  QUEUED
  PROCESSED
  DUPLICATE
  FAILED
}

enum ChatEntityType {
  CHAT
  CHANNEL
}

enum ChatBotMembershipRole {
  PRIMARY
  STANDBY
}

enum ChatBotMembershipStatus {
  ACTIVE
  REMOVED
}

enum ManagedEntityAccessState {
  GRANTED
  USER_DENIED
  BOT_DENIED
}

enum ManagedEntityAccessRole {
  OWNER
  ADMIN
  MEMBER
  UNKNOWN
}

enum ChannelAutoPostButtonsMode {
  OFF
  COMMENTS
  SUGGEST
  BOTH
}

enum ChannelSuggestionEntryMode {
  BOT
  MINIAPP
}

enum ManagedPollStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ManagedGiveawayStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  DRAWING
  COMPLETED
  CANCELED
}

enum GiveawayEligibilityState {
  PENDING
  VERIFIED
  REJECTED
}

enum ManagedGiveawayWinnerStatus {
  SELECTED
  CLAIMED
  DELIVERED
  EXPIRED
  REROLLED
}

enum ManagedBroadcastStatus {
  ACTIVE
  PARTIAL
  FAILED
  COMPLETED
  CANCELED
}

enum ManagedBroadcastDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELED
}

enum ManagedEntityFavoriteType {
  IMPORTANT
  WATCH
  BROADCAST
  TEST
  PARTNER
  SERVICE
}

model Chat {
  id           String         @id
  botId        String?        @map("bot_id")
  primaryBotId String?        @map("primary_bot_id")
  title        String
  entityType   ChatEntityType @default(CHAT) @map("entity_type")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  settings                 ChatSettings?
  rules                    ChatRules?
  poll                     ManagedPoll?
  channelSettings          ChannelSettings?
  admins                   ChatAdminAllowlist[]
  domains                  DomainAllowlist[]
  violations               Violation[]
  events                   ModerationEvent[]
  auditLogs                AuditLog[]
  channelAudienceSnapshots ChannelAudienceSnapshot[]
  channelPosts             ChannelPost[]
  channelStatsSyncState    ChannelStatsSyncState?
  managedBroadcasts        ManagedBroadcast[]
  managedGiveaways         ManagedGiveaway[]
  botMemberships           ChatBotMembership[]
  accessEdges              ManagedEntityAccessEdge[]
  favorites                ManagedEntityFavorite[]
  participantImmunities    ChatParticipantModerationImmunity[]
  invitationAccessProgress ChatInvitationAccessProgress[]

  @@index([botId], map: "chats_bot_id_idx")
  @@index([primaryBotId], map: "chats_primary_bot_id_idx")
  @@map("chats")
}

model ChatBotMembership {
  id                  String                  @id @default(cuid())
  chatId              String                  @map("chat_id")
  botId               String                  @map("bot_id")
  role                ChatBotMembershipRole   @default(STANDBY)
  status              ChatBotMembershipStatus @default(ACTIVE)
  capabilities        Json                    @default("[]")
  permissionsSnapshot Json?                   @map("permissions_snapshot")
  lastSeenAt          DateTime?               @map("last_seen_at")
  lastWebhookAt       DateTime?               @map("last_webhook_at")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, botId], map: "chat_bot_memberships_chat_id_bot_id_key")
  @@index([botId, role, status], map: "chat_bot_memberships_bot_id_role_status_idx")
  @@index([chatId, status], map: "chat_bot_memberships_chat_id_status_idx")
  @@map("chat_bot_memberships")
}

model ChatParticipantModerationImmunity {
  id                  String   @id @default(cuid())
  chatId              String   @map("chat_id")
  userId              String   @map("user_id")
  expiresAt           DateTime @map("expires_at")
  dailyViolationLimit Int      @map("daily_violation_limit")
  dailyViolationUsage Int      @default(0) @map("daily_violation_usage")
  usageDateKey        String?  @map("usage_date_key")
  createdByUserId     String?  @map("created_by_user_id")
  updatedByUserId     String?  @map("updated_by_user_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId], map: "chat_participant_moderation_immunities_chat_id_user_id_key")
  @@index([chatId, expiresAt], map: "chat_participant_moderation_immunities_chat_id_expires_at_idx")
  @@map("chat_participant_moderation_immunities")
}

