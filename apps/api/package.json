{
  "name": "@maxim/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "npm run prisma:generate && tsx watch src/main.ts",
    "dev:ingress": "APP_ROLE=ingress npm run dev",
    "dev:enqueue": "APP_ROLE=enqueue npm run dev",
    "dev:moderation": "APP_ROLE=moderation npm run dev",
    "dev:action": "APP_ROLE=action npm run dev",
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:ingress": "APP_ROLE=ingress node dist/main.js",
    "start:enqueue": "APP_ROLE=enqueue node dist/main.js",
    "start:moderation": "APP_ROLE=moderation node dist/main.js",
    "start:action": "APP_ROLE=action node dist/main.js",
    "typecheck": "npm run prisma:generate && tsc -p tsconfig.json --noEmit",
    "test": "npm run prisma:generate && jest --config jest.config.cjs --runInBand",
    "test:watch": "jest --config jest.config.cjs --watch",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@maxim/contracts": "0.1.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-fastify": "^11.0.11",
    "@prisma/client": "^6.4.1",
    "bullmq": "^5.41.7",
    "ioredis": "^5.5.0",
    "nestjs-pino": "^4.4.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.11",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "tsx": "^4.19.3"
  }
}
